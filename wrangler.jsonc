{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-novaaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "af569c5d-3965-414b-84d3-2f3ba91eb11a","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f02e45d52d2a41aab3665194fe65fe90" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
